{
  "name": "presentation-shelf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An automatically indexed PDF presentation library for GitHub Pages.",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "playwright": "1.64.0"
  }
}
